# Copy this file to .env and fill in your key. .env is git-ignored, so the key never reaches GitHub.
GROQ_API_KEY=your-key-here

# Optional: use a different OpenAI-compatible provider, e.g. Ollama on your own PC.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# DM_MODEL=openai/gpt-oss-120b
# COMPANION_MODEL=openai/gpt-oss-120b   (defaults to DM_MODEL)
# HELPER_MODEL=openai/gpt-oss-20b
