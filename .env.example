# Copy this file to .env and fill in your keys. .env is git-ignored, so keys never reach GitHub.

# Claude (Anthropic API). When set, Claude is the main provider.
# ANTHROPIC_API_KEY=your-anthropic-key
# CLAUDE_DM_MODEL=claude-sonnet-5-5           (the Dungeon Master)
# CLAUDE_HELPER_MODEL=claude-haiku-5-5        (bookkeeping, and companions unless set below)
# CLAUDE_COMPANION_MODEL=claude-haiku-5-5
# CLAUDE_EFFORT=low                           (low, medium or high: how hard Claude thinks)

# Groq. On its own it runs everything; next to a Claude key it takes over whenever Claude fails.
GROQ_API_KEY=your-key-here

# Optional: use a different OpenAI-compatible provider instead of Groq, e.g. Ollama on your own PC.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# DM_MODEL=openai/gpt-oss-120b
# COMPANION_MODEL=openai/gpt-oss-120b   (defaults to DM_MODEL)
# HELPER_MODEL=openai/gpt-oss-20b
